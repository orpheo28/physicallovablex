{
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Label"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "stage": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stage that introduced the assumption",
          "title": "Stage"
        }
      },
      "required": [
        "id",
        "text",
        "label"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "BuildStrategy": {
      "additionalProperties": false,
      "description": "W21: how this product realistically gets built \u2014 design everything, assemble bought-in modules, or customise an\nODM reference platform. Figures are Estimates with their assumptions.",
      "properties": {
        "strategy": {
          "enum": [
            "full_design",
            "module_assembly",
            "odm_customization"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "title": {
          "description": "e.g. 'Full design', 'Module assembly', 'ODM customisation'",
          "title": "Title",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "customisable": {
          "description": "What the founder designs / chooses",
          "items": {
            "type": "string"
          },
          "title": "Customisable",
          "type": "array"
        },
        "not_customisable": {
          "description": "What comes from the modules / the ODM platform",
          "items": {
            "type": "string"
          },
          "title": "Not Customisable",
          "type": "array"
        },
        "moq": {
          "$ref": "#/$defs/LabeledValue",
          "description": "Typical minimum order quantity (units), Estimate"
        },
        "entry_cost": {
          "$ref": "#/$defs/LabeledValue",
          "description": "Typical entry cost (NRE, tooling, certification) before the first order, Estimate"
        },
        "lead_time": {
          "$ref": "#/$defs/LabeledValue",
          "description": "Typical time from frozen design to first production units (weeks), Estimate"
        },
        "path": {
          "description": "Realistic steps (for ODM: find a close reference platform\u2026)",
          "items": {
            "type": "string"
          },
          "title": "Path",
          "type": "array"
        },
        "certifications_note": {
          "default": "",
          "title": "Certifications Note",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        }
      },
      "required": [
        "strategy",
        "title",
        "explanation",
        "customisable",
        "moq",
        "entry_cost",
        "lead_time"
      ],
      "title": "BuildStrategy",
      "type": "object"
    },
    "CheckVerdict": {
      "enum": [
        "pass",
        "warn",
        "fail",
        "info"
      ],
      "title": "CheckVerdict",
      "type": "string"
    },
    "DesignRisk": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "risk": {
          "title": "Risk",
          "type": "string"
        },
        "mitigation": {
          "title": "Mitigation",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "major"
        }
      },
      "required": [
        "id",
        "risk",
        "mitigation"
      ],
      "title": "DesignRisk",
      "type": "object"
    },
    "DevKitLine": {
      "additionalProperties": false,
      "properties": {
        "part": {
          "title": "Part",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "qty": {
          "default": 1,
          "title": "Qty",
          "type": "integer"
        },
        "lcsc_pn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lcsc Pn"
        },
        "unit_price": {
          "$ref": "#/$defs/LabeledValue"
        }
      },
      "required": [
        "part",
        "role",
        "unit_price"
      ],
      "title": "DevKitLine",
      "type": "object"
    },
    "ElectronicsArchitecture": {
      "additionalProperties": false,
      "properties": {
        "mcu_family": {
          "enum": [
            "nrf52",
            "esp32",
            "stm32",
            "avr",
            "generic"
          ],
          "title": "Mcu Family",
          "type": "string"
        },
        "mcu_part": {
          "title": "Mcu Part",
          "type": "string"
        },
        "radio": {
          "items": {
            "type": "string"
          },
          "title": "Radio",
          "type": "array"
        },
        "power_tree": {
          "items": {
            "$ref": "#/$defs/PowerNode"
          },
          "title": "Power Tree",
          "type": "array"
        },
        "connections": {
          "items": {
            "$ref": "#/$defs/NetConnection"
          },
          "title": "Connections",
          "type": "array"
        },
        "power_budget": {
          "items": {
            "$ref": "#/$defs/PowerBudgetLine"
          },
          "title": "Power Budget",
          "type": "array"
        },
        "average_current": {
          "$ref": "#/$defs/LabeledValue"
        },
        "battery_voltage": {
          "anyOf": [
            {
              "$ref": "#/$defs/LabeledValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "battery_capacity": {
          "anyOf": [
            {
              "$ref": "#/$defs/LabeledValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "battery_life": {
          "anyOf": [
            {
              "$ref": "#/$defs/LabeledValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pcb_note": {
          "default": "PCB layout: next step (human or text-to-PCB)",
          "title": "Pcb Note",
          "type": "string"
        }
      },
      "required": [
        "mcu_family",
        "mcu_part",
        "power_tree",
        "connections",
        "power_budget",
        "average_current"
      ],
      "title": "ElectronicsArchitecture",
      "type": "object"
    },
    "EngineeringCheck": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "domain": {
          "enum": [
            "stability",
            "hydrodynamics",
            "power",
            "ingress",
            "airflow",
            "fluid",
            "solar",
            "thermal",
            "mass",
            "geometry",
            "flight",
            "regulatory"
          ],
          "title": "Domain",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/LabeledValue"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human wording of the pass/warn/fail rule, e.g. '\u2265 15\u00b0 (design target)'",
          "title": "Threshold"
        },
        "verdict": {
          "$ref": "#/$defs/CheckVerdict"
        },
        "formula": {
          "description": "Formula and assumptions, with the inputs' labels",
          "title": "Formula",
          "type": "string"
        },
        "inputs": {
          "description": "Inputs of the formula (each labeled)",
          "items": {
            "$ref": "#/$defs/LabeledValue"
          },
          "title": "Inputs",
          "type": "array"
        },
        "notes": {
          "description": "e.g. the sealing checklist of an IP check",
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "domain",
        "value",
        "verdict",
        "formula"
      ],
      "title": "EngineeringCheck",
      "type": "object"
    },
    "FirmwareProject": {
      "additionalProperties": false,
      "properties": {
        "framework": {
          "enum": [
            "zephyr",
            "arduino"
          ],
          "title": "Framework",
          "type": "string"
        },
        "mcu_family": {
          "title": "Mcu Family",
          "type": "string"
        },
        "connectivity": {
          "description": "e.g. 'BLE GATT service', 'Wi-Fi + MQTT'",
          "title": "Connectivity",
          "type": "string"
        },
        "url": {
          "description": "/files/<project_id>/firmware.zip",
          "title": "Url",
          "type": "string"
        },
        "files": {
          "items": {
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        },
        "generated_by": {
          "description": "'template' | 'llm:<model slug>'",
          "title": "Generated By",
          "type": "string"
        },
        "note": {
          "default": "Generated code \u2014 not compiled or tested",
          "title": "Note",
          "type": "string"
        },
        "pending_llm": {
          "default": false,
          "description": "An LLM version is being generated in the background; re-GET to pick it up",
          "title": "Pending Llm",
          "type": "boolean"
        }
      },
      "required": [
        "framework",
        "mcu_family",
        "connectivity",
        "url",
        "files",
        "generated_by"
      ],
      "title": "FirmwareProject",
      "type": "object"
    },
    "InstallerMatch": {
      "additionalProperties": false,
      "properties": {
        "factory_id": {
          "title": "Factory Id",
          "type": "string"
        },
        "name": {
          "description": "Fictional installer name \u2014 ends with '(fictional)'",
          "title": "Name",
          "type": "string"
        },
        "region": {
          "title": "Region",
          "type": "string"
        },
        "certifications": {
          "items": {
            "type": "string"
          },
          "title": "Certifications",
          "type": "array"
        },
        "lead_time_days": {
          "title": "Lead Time Days",
          "type": "integer"
        },
        "label": {
          "const": "fictional",
          "default": "fictional",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "factory_id",
        "name",
        "region",
        "certifications",
        "lead_time_days"
      ],
      "title": "InstallerMatch",
      "type": "object"
    },
    "Label": {
      "description": "The four honesty labels. UI text: Measured / Sourced / Estimate / Fictional \u2014 demo data.",
      "enum": [
        "measured",
        "sourced",
        "estimate",
        "fictional"
      ],
      "title": "Label",
      "type": "string"
    },
    "LabeledValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "description": "e.g. USD, EUR, mm, g, days, weeks, pct, units, man-days",
          "title": "Unit",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Label"
        },
        "source_or_assumption": {
          "description": "Sourced: '<source>, <YYYY-MM-DD>'. Estimate: the assumption. Measured: the check. Fictional: 'demo data'.",
          "title": "Source Or Assumption",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit",
        "label",
        "source_or_assumption"
      ],
      "title": "LabeledValue",
      "type": "object"
    },
    "NetConnection": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "bus": {
          "enum": [
            "power",
            "i2c",
            "spi",
            "uart",
            "gpio",
            "pwm",
            "adc",
            "rf",
            "usb",
            "analog",
            "can"
          ],
          "title": "Bus",
          "type": "string"
        },
        "signals": {
          "description": "Net names, e.g. 'SDA, SCL, INT1'",
          "title": "Signals",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target",
        "bus",
        "signals"
      ],
      "title": "NetConnection",
      "type": "object"
    },
    "PowerBudgetLine": {
      "additionalProperties": false,
      "properties": {
        "block": {
