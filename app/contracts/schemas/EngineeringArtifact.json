        "enclosure_method": {
          "title": "Enclosure Method",
          "type": "string"
        },
        "enclosure_volume": {
          "$ref": "#/$defs/LabeledValue"
        },
        "units": {
          "description": "Prototype quantity (input)",
          "title": "Units",
          "type": "integer"
        },
        "cost_lines": {
          "items": {
            "$ref": "#/$defs/PrototypeCostLine"
          },
          "title": "Cost Lines",
          "type": "array"
        },
        "devkit_bom": {
          "items": {
            "$ref": "#/$defs/DevKitLine"
          },
          "title": "Devkit Bom",
