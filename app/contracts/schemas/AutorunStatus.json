{
  "$defs": {
    "AutorunState": {
      "enum": [
        "idle",
        "running",
        "done",
        "failed"
      ],
      "title": "AutorunState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Progress of the background autorun (stages 1-7, or 1-13 + Factory Pack in autofill mode). Poll GET /projects/{id} every ~2 s.",
  "properties": {
    "state": {
      "$ref": "#/$defs/AutorunState",
      "default": "idle"
    },
    "through": {
      "default": 7,
      "description": "Last stage the run goes to: 7 (default) or 13 (autofill: also auto-approves the recommended quote at stage 8 and builds the Factory Pack)",
      "enum": [
        7,
        13
      ],
      "title": "Through",
      "type": "integer"
    },
    "current_stage": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Stage being run while state == running",
      "title": "Current Stage"
    },
    "completed_stages": {
      "items": {
        "type": "integer"
      },
      "title": "Completed Stages",
      "type": "array"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "title": "AutorunStatus",
  "type": "object"
}
