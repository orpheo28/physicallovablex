{
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Label"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "stage": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stage that introduced the assumption",
          "title": "Stage"
        }
      },
      "required": [
        "id",
        "text",
        "label"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "DefectClass": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "spec_ref": {
          "description": "Spec line (part id / tolerance / certification) the defect maps to",
          "title": "Spec Ref",
          "type": "string"
        },
        "check_method": {
          "title": "Check Method",
          "type": "string"
        },
        "aql": {
          "description": "Acceptable quality limit for this class, e.g. 0, 2.5, 4.0",
          "title": "Aql",
          "type": "number"
        }
      },
      "required": [
        "id",
        "severity",
        "description",
        "spec_ref",
        "check_method",
        "aql"
      ],
      "title": "DefectClass",
      "type": "object"
    },
    "Label": {
      "description": "The four honesty labels. UI text: Measured / Sourced / Estimate / Fictional \u2014 demo data.",
      "enum": [
        "measured",
        "sourced",
        "estimate",
        "fictional"
      ],
      "title": "Label",
      "type": "string"
    },
    "LabeledValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "description": "e.g. USD, EUR, mm, g, days, weeks, pct, units, man-days",
          "title": "Unit",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Label"
        },
        "source_or_assumption": {
          "description": "Sourced: '<source>, <YYYY-MM-DD>'. Estimate: the assumption. Measured: the check. Fictional: 'demo data'.",
          "title": "Source Or Assumption",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit",
        "label",
        "source_or_assumption"
      ],
      "title": "LabeledValue",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "critical",
        "major",
        "minor"
      ],
      "title": "Severity",
      "type": "string"
    },
    "StageStatus": {
      "enum": [
        "not_started",
        "draft",
        "validated"
      ],
      "title": "StageStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/StageStatus",
      "default": "draft"
    },
    "fallback": {
      "default": false,
      "description": "True when served from a fixture after an error",
      "title": "Fallback",
      "type": "boolean"
    },
    "fallback_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Reason"
    },
    "generated_by": {
      "default": "fixture",
      "description": "'fixture' | 'code' | 'llm:<model slug>'",
      "title": "Generated By",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "assumptions": {
      "items": {
        "$ref": "#/$defs/Assumption"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "stage": {
      "const": 10,
      "default": 10,
      "title": "Stage",
      "type": "integer"
    },
    "standard": {
      "default": "ISO 2859-1 (ANSI/ASQ Z1.4)",
      "title": "Standard",
      "type": "string"
    },
    "inspection_level": {
      "default": "General II",
      "title": "Inspection Level",
      "type": "string"
    },
    "lot_size": {
      "title": "Lot Size",
      "type": "integer"
    },
    "sample_size": {
      "$ref": "#/$defs/LabeledValue"
    },
    "defects": {
      "items": {
        "$ref": "#/$defs/DefectClass"
      },
      "title": "Defects",
      "type": "array"
    },
    "inspection_man_days": {
      "$ref": "#/$defs/LabeledValue"
    },
    "man_day_rate": {
      "$ref": "#/$defs/LabeledValue"
    },
    "inspection_cost": {
      "$ref": "#/$defs/LabeledValue"
    }
  },
  "required": [
    "project_id",
    "lot_size",
    "sample_size",
    "defects",
    "inspection_man_days",
    "man_day_rate",
    "inspection_cost"
  ],
  "title": "QCArtifact",
  "type": "object"
}
