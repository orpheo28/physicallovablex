      "required": [
        "location",
        "latitude",
        "longitude",
        "location_assumed",
        "roof_area",
        "module_power",
        "module_count",
        "peak_power",
        "specific_yield",
        "annual_energy",
        "install_cost",
        "annual_savings",
        "payback",
        "pvgis_url"
