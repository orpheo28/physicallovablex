      "title": "Rfq Id",
      "type": "string"
    },
    "factory_id": {
      "title": "Factory Id",
      "type": "string"
    },
    "turn": {
      "title": "Turn",
      "type": "integer"
    },
    "speaker": {
      "$ref": "#/$defs/Speaker"
    },
    "message": {
      "title": "Message",
      "type": "string"
