        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Upstream node id (None for a source)",
          "title": "Parent"
        },
        "voltage": {
          "$ref": "#/$defs/LabeledValue"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "voltage"
      ],
      "title": "PowerNode",
      "type": "object"
    },
    "PrototypeCostLine": {
      "additionalProperties": false,
      "properties": {
        "item": {
          "title": "Item",
          "type": "string"
        },
        "amount": {
          "$ref": "#/$defs/LabeledValue"
        }
      },
      "required": [
        "item",
        "amount"
      ],
      "title": "PrototypeCostLine",
      "type": "object"
    },
    "PrototypePath": {
      "additionalProperties": false,
