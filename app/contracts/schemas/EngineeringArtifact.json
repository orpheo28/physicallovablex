        "location": {
          "title": "Location",
          "type": "string"
        },
        "latitude": {
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "title": "Longitude",
          "type": "number"
        },
        "location_assumed": {
          "description": "True when the location was not in the prompt (default demo site)",
