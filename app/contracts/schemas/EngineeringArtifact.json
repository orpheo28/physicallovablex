            "$ref": "#/$defs/LabeledValue"
          },
          "title": "Monthly Energy",
          "type": "array"
        },
        "install_cost": {
          "$ref": "#/$defs/LabeledValue"
        },
        "annual_savings": {
          "$ref": "#/$defs/LabeledValue"
        },
        "payback": {
          "$ref": "#/$defs/LabeledValue"
        },
        "pvgis_url": {
          "title": "Pvgis Url",
          "type": "string"
        }
