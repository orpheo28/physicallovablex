{
  "$defs": {
    "Label": {
      "description": "The four honesty labels. UI text: Measured / Sourced / Estimate / Fictional \u2014 demo data.",
      "enum": [
        "measured",
        "sourced",
        "estimate",
        "fictional"
      ],
      "title": "Label",
      "type": "string"
    },
    "LabeledValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "description": "e.g. USD, EUR, mm, g, days, weeks, pct, units, man-days",
          "title": "Unit",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Label"
        },
        "source_or_assumption": {
          "description": "Sourced: '<source>, <YYYY-MM-DD>'. Estimate: the assumption. Measured: the check. Fictional: 'demo data'.",
          "title": "Source Or Assumption",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit",
        "label",
        "source_or_assumption"
      ],
      "title": "LabeledValue",
      "type": "object"
    },
    "PartAlternative": {
      "additionalProperties": false,
      "description": "W21b: a cheaper / better-stocked catalogue part proposed for a risky BOM line (structured, no text parsing).",
      "properties": {
        "part": {
          "description": "Manufacturer part number + package",
          "title": "Part",
          "type": "string"
        },
        "lcsc_pn": {
          "title": "Lcsc Pn",
          "type": "string"
        },
        "price": {
          "$ref": "#/$defs/LabeledValue",
          "description": "Unit price at the order quantity (Sourced: LCSC snapshot)"
        },
        "stock": {
          "anyOf": [
            {
              "$ref": "#/$defs/LabeledValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "label": {
          "$ref": "#/$defs/Label",
          "default": "sourced"
        }
      },
      "required": [
        "part",
        "lcsc_pn",
        "price"
      ],
      "title": "PartAlternative",
      "type": "object"
    },
    "RiskLevel": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "W21b: structured risk of one part: level, reasons and the proposed alternative (None when the snapshot has none).",
  "properties": {
    "level": {
      "$ref": "#/$defs/RiskLevel"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "alternative": {
      "anyOf": [
        {
          "$ref": "#/$defs/PartAlternative"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "level"
  ],
  "title": "ComponentRiskSummary",
  "type": "object"
}
