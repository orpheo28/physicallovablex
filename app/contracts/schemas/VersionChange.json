{
  "$defs": {
    "ComponentRiskSummary": {
      "additionalProperties": false,
      "description": "W21b: structured risk of one part: level, reasons and the proposed alternative (None when the snapshot has none).",
      "properties": {
        "level": {
          "$ref": "#/$defs/RiskLevel"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "alternative": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartAlternative"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "level"
      ],
      "title": "ComponentRiskSummary",
      "type": "object"
    },
    "Label": {
      "description": "The four honesty labels. UI text: Measured / Sourced / Estimate / Fictional \u2014 demo data.",
      "enum": [
        "measured",
        "sourced",
        "estimate",
        "fictional"
      ],
      "title": "Label",
      "type": "string"
    },
    "LabeledValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "description": "e.g. USD, EUR, mm, g, days, weeks, pct, units, man-days",
          "title": "Unit",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Label"
        },
        "source_or_assumption": {
          "description": "Sourced: '<source>, <YYYY-MM-DD>'. Estimate: the assumption. Measured: the check. Fictional: 'demo data'.",
          "title": "Source Or Assumption",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit",
        "label",
        "source_or_assumption"
      ],
      "title": "LabeledValue",
      "type": "object"
    },
    "PartAlternative": {
      "additionalProperties": false,
      "description": "W21b: a cheaper / better-stocked catalogue part proposed for a risky BOM line (structured, no text parsing).",
      "properties": {
        "part": {
          "description": "Manufacturer part number + package",
          "title": "Part",
          "type": "string"
        },
        "lcsc_pn": {
          "title": "Lcsc Pn",
          "type": "string"
        },
        "price": {
          "$ref": "#/$defs/LabeledValue",
          "description": "Unit price at the order quantity (Sourced: LCSC snapshot)"
        },
        "stock": {
          "anyOf": [
            {
              "$ref": "#/$defs/LabeledValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "label": {
          "$ref": "#/$defs/Label",
          "default": "sourced"
        }
      },
      "required": [
        "part",
        "lcsc_pn",
        "price"
      ],
      "title": "PartAlternative",
      "type": "object"
    },
    "RiskLevel": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "area": {
      "enum": [
        "color",
        "material",
        "shape",
        "dimensions",
        "feature",
        "component",
        "price",
        "markets",
        "requirement",
        "certification",
        "cost",
        "performance"
      ],
      "title": "Area",
      "type": "string"
    },
    "label": {
      "description": "Human wording, e.g. 'Colour', 'Pod height', 'Optical heart-rate sensor'",
      "title": "Label",
      "type": "string"
    },
    "before": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Before"
    },
    "after": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "After"
    },
    "label_kind": {
      "$ref": "#/$defs/Label",
      "description": "Honesty label of the new value: measured (CAD), sourced (LCSC), estimate, fictional"
    },
    "risk": {
      "anyOf": [
        {
          "$ref": "#/$defs/ComponentRiskSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "W21b: on a 'Component added' change \u2014 structured supply risk + proposed cheaper in-stock alternative"
    }
  },
  "required": [
    "area",
    "label",
    "label_kind"
  ],
  "title": "VersionChange",
  "type": "object"
}
