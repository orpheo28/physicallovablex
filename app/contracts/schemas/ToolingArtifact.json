{
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Label"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "stage": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stage that introduced the assumption",
          "title": "Stage"
        }
      },
      "required": [
        "id",
        "text",
        "label"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "Label": {
      "description": "The four honesty labels. UI text: Measured / Sourced / Estimate / Fictional \u2014 demo data.",
      "enum": [
        "measured",
        "sourced",
        "estimate",
        "fictional"
      ],
      "title": "Label",
      "type": "string"
    },
    "LabeledValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "description": "e.g. USD, EUR, mm, g, days, weeks, pct, units, man-days",
          "title": "Unit",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Label"
        },
        "source_or_assumption": {
          "description": "Sourced: '<source>, <YYYY-MM-DD>'. Estimate: the assumption. Measured: the check. Fictional: 'demo data'.",
          "title": "Source Or Assumption",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit",
        "label",
        "source_or_assumption"
      ],
      "title": "LabeledValue",
      "type": "object"
    },
    "Milestone": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MilestoneKind"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "duration_days": {
          "$ref": "#/$defs/LabeledValue"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "payment": {
          "anyOf": [
            {
              "$ref": "#/$defs/LabeledValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cash out at this milestone, if any"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "start_date",
        "end_date",
        "duration_days"
      ],
      "title": "Milestone",
      "type": "object"
    },
    "MilestoneKind": {
      "enum": [
        "deposit",
        "tooling_t0",
        "tooling_t1",
        "golden_sample",
        "certification",
        "mass_production",
        "pre_shipment_inspection",
        "shipment",
        "delivered",
        "other"
      ],
      "title": "MilestoneKind",
      "type": "string"
    },
    "PaymentScheduleItem": {
      "additionalProperties": false,
      "properties": {
        "milestone_id": {
          "title": "Milestone Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "pct_of_order": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pct Of Order"
        },
        "amount": {
          "$ref": "#/$defs/LabeledValue"
        },
        "due_date": {
          "format": "date",
          "title": "Due Date",
          "type": "string"
        }
      },
      "required": [
        "milestone_id",
        "description",
        "amount",
        "due_date"
      ],
      "title": "PaymentScheduleItem",
      "type": "object"
    },
    "StageStatus": {
      "enum": [
        "not_started",
        "draft",
        "validated"
      ],
      "title": "StageStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/StageStatus",
      "default": "draft"
    },
    "fallback": {
      "default": false,
      "description": "True when served from a fixture after an error",
      "title": "Fallback",
      "type": "boolean"
    },
    "fallback_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Reason"
    },
    "generated_by": {
      "default": "fixture",
      "description": "'fixture' | 'code' | 'llm:<model slug>'",
      "title": "Generated By",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "assumptions": {
      "items": {
        "$ref": "#/$defs/Assumption"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "stage": {
      "const": 9,
      "default": 9,
      "title": "Stage",
      "type": "integer"
    },
    "milestones": {
      "items": {
        "$ref": "#/$defs/Milestone"
      },
      "title": "Milestones",
      "type": "array"
    },
    "payment_schedule": {
      "items": {
        "$ref": "#/$defs/PaymentScheduleItem"
      },
      "title": "Payment Schedule",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "milestones",
    "payment_schedule"
  ],
  "title": "ToolingArtifact",
  "type": "object"
}
