{
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Label"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "stage": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stage that introduced the assumption",
          "title": "Stage"
        }
      },
      "required": [
        "id",
        "text",
        "label"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "CashPoint": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "milestone_id": {
          "title": "Milestone Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "cash_out": {
          "$ref": "#/$defs/LabeledValue"
        },
        "cumulative": {
          "$ref": "#/$defs/LabeledValue"
        }
      },
      "required": [
        "date",
        "milestone_id",
        "description",
        "cash_out",
        "cumulative"
      ],
      "title": "CashPoint",
      "type": "object"
    },
    "FinancingOption": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "preorders",
            "crowdfunding",
            "inventory_financing",
            "revenue_based",
            "equity",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/LabeledValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pros": {
          "items": {
            "type": "string"
          },
          "title": "Pros",
          "type": "array"
        },
        "cons": {
          "items": {
            "type": "string"
          },
          "title": "Cons",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "name",
        "description"
      ],
      "title": "FinancingOption",
      "type": "object"
    },
    "Label": {
      "description": "The four honesty labels. UI text: Measured / Sourced / Estimate / Fictional \u2014 demo data.",
      "enum": [
        "measured",
        "sourced",
        "estimate",
        "fictional"
      ],
      "title": "Label",
      "type": "string"
    },
    "LabeledValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "description": "e.g. USD, EUR, mm, g, days, weeks, pct, units, man-days",
          "title": "Unit",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Label"
        },
        "source_or_assumption": {
          "description": "Sourced: '<source>, <YYYY-MM-DD>'. Estimate: the assumption. Measured: the check. Fictional: 'demo data'.",
          "title": "Source Or Assumption",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit",
        "label",
        "source_or_assumption"
      ],
      "title": "LabeledValue",
      "type": "object"
    },
    "StageStatus": {
      "enum": [
        "not_started",
        "draft",
        "validated"
      ],
      "title": "StageStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/StageStatus",
      "default": "draft"
    },
    "fallback": {
      "default": false,
      "description": "True when served from a fixture after an error",
      "title": "Fallback",
      "type": "boolean"
    },
    "fallback_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Reason"
    },
    "generated_by": {
      "default": "fixture",
      "description": "'fixture' | 'code' | 'llm:<model slug>'",
      "title": "Generated By",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "assumptions": {
      "items": {
        "$ref": "#/$defs/Assumption"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "stage": {
      "const": 12,
      "default": 12,
      "title": "Stage",
      "type": "integer"
    },
    "cash_curve": {
      "items": {
        "$ref": "#/$defs/CashPoint"
      },
      "title": "Cash Curve",
      "type": "array"
    },
    "total_cash": {
      "$ref": "#/$defs/LabeledValue"
    },
    "matches_stage5_total": {
      "title": "Matches Stage5 Total",
      "type": "boolean"
    },
    "options": {
      "items": {
        "$ref": "#/$defs/FinancingOption"
      },
      "title": "Options",
      "type": "array"
    },
    "stage5_total": {
      "anyOf": [
        {
          "$ref": "#/$defs/LabeledValue"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Stage 5 budget reference (total cash needed)"
    },
    "reconciliation_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Why the curve differs from stage 5 (e.g. the approved quote replaced the estimate); None if equal",
      "title": "Reconciliation Note"
    }
  },
  "required": [
    "project_id",
    "cash_curve",
    "total_cash",
    "matches_stage5_total",
    "options"
  ],
  "title": "FinancingArtifact",
  "type": "object"
}
