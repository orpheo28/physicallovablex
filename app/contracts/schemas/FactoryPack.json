{
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Label"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "stage": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stage that introduced the assumption",
          "title": "Stage"
        }
      },
      "required": [
        "id",
        "text",
        "label"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "BOMCategory": {
      "enum": [
        "electronic",
        "mechanical",
        "packaging"
      ],
      "title": "BOMCategory",
      "type": "string"
    },
    "BOMItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "part": {
          "title": "Part",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/BOMCategory"
        },
        "qty": {
          "description": "Quantity per finished unit",
          "title": "Qty",
          "type": "number"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "manufacturer_pn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manufacturer Pn"
        },
        "lcsc_pn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. 'C725790' when matched to the LCSC snapshot",
          "title": "Lcsc Pn"
        },
        "unit_cost_est": {
          "anyOf": [
            {
              "$ref": "#/$defs/LabeledValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "risk": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentRisk"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "alternative": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alternative"
        }
      },
      "required": [
        "id",
        "part",
        "category",
        "qty"
      ],
      "title": "BOMItem",
      "type": "object"
    },
    "CadFile": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "step",
            "stl",
            "glb",
            "pdf",
            "png",
            "svg"
          ],
          "title": "Format",
          "type": "string"
        },
        "url": {
          "description": "Served by the API, e.g. /files/<project_id>/enclosure.step",
          "title": "Url",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "size_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        }
      },
      "required": [
        "format",
        "url"
      ],
      "title": "CadFile",
      "type": "object"
    },
    "Certification": {
      "additionalProperties": false,
      "properties": {
        "market": {
          "description": "US, EU, UK, ...",
          "title": "Market",
          "type": "string"
        },
        "standard": {
          "description": "e.g. FCC Part 15B, CE (LVD/EMC/RED), UKCA, UN38.3",
          "title": "Standard",
          "type": "string"
        },
        "applies_because": {
          "title": "Applies Because",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "cost_est": {
          "$ref": "#/$defs/LabeledValue"
        },
        "lead_time_weeks": {
          "$ref": "#/$defs/LabeledValue"
        }
      },
      "required": [
        "market",
        "standard",
        "applies_because",
        "cost_est",
        "lead_time_weeks"
      ],
      "title": "Certification",
      "type": "object"
    },
    "ComponentRisk": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "$ref": "#/$defs/RiskLevel"
        },
        "reasons": {
          "description": "e.g. EOL, single source, long lead time, low stock",
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "level"
      ],
      "title": "ComponentRisk",
      "type": "object"
    },
    "CostTier": {
      "additionalProperties": false,
      "properties": {
        "quantity": {
          "title": "Quantity",
          "type": "integer"
        },
        "bom_cost": {
          "$ref": "#/$defs/LabeledValue"
        },
        "assembly_cost": {
          "$ref": "#/$defs/LabeledValue"
        },
        "packaging_cost": {
          "$ref": "#/$defs/LabeledValue"
        },
        "unit_cost": {
          "$ref": "#/$defs/LabeledValue",
          "description": "Ex-works unit cost (FOB basis) at this tier"
        },
        "tooling_amortisation": {
          "$ref": "#/$defs/LabeledValue"
        },
        "margin_pct": {
          "$ref": "#/$defs/LabeledValue",
          "description": "Margin at target retail price, landed-cost estimate basis"
        }
      },
      "required": [
        "quantity",
        "bom_cost",
        "assembly_cost",
        "packaging_cost",
        "unit_cost",
        "tooling_amortisation",
        "margin_pct"
      ],
      "title": "CostTier",
      "type": "object"
    },
    "DFMIssue": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "category": {
          "enum": [
            "draft",
            "undercut",
            "projection",
            "wall_thickness",
            "tolerance",
            "assembly",
            "material",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/DFMMethod"
        },
        "part_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Part Id"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "fix": {
          "title": "Fix",
          "type": "string"
        },
        "rule_citation": {
          "description": "The rule the finding is based on, with its source",
          "title": "Rule Citation",
          "type": "string"
        },
        "measurement": {
          "anyOf": [
            {
              "$ref": "#/$defs/LabeledValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required when method == measured"
        },
        "resolved": {
          "default": false,
          "title": "Resolved",
          "type": "boolean"
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        }
      },
      "required": [
        "id",
        "severity",
        "category",
        "method",
        "description",
        "fix",
        "rule_citation"
      ],
      "title": "DFMIssue",
      "type": "object"
    },
    "DFMMethod": {
      "enum": [
        "measured",
        "ai_reviewed"
      ],
      "title": "DFMMethod",
      "type": "string"
    },
    "Dimensions": {
      "additionalProperties": false,
      "properties": {
        "length": {
          "$ref": "#/$defs/LabeledValue"
        },
        "width": {
          "$ref": "#/$defs/LabeledValue"
        },
        "height": {
          "$ref": "#/$defs/LabeledValue"
        }
      },
      "required": [
        "length",
        "width",
        "height"
      ],
      "title": "Dimensions",
      "type": "object"
    },
    "FactoryQuestion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "en": {
          "title": "En",
          "type": "string"
        },
        "cn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cn"
        },
        "cn_review_note": {
          "default": "Machine-translated \u2014 to be reviewed by a native speaker",
          "title": "Cn Review Note",
          "type": "string"
        }
      },
      "required": [
        "id",
        "en"
      ],
      "title": "FactoryQuestion",
      "type": "object"
    },
    "Label": {
      "description": "The four honesty labels. UI text: Measured / Sourced / Estimate / Fictional \u2014 demo data.",
      "enum": [
        "measured",
        "sourced",
        "estimate",
        "fictional"
      ],
      "title": "Label",
      "type": "string"
    },
    "LabeledValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "description": "e.g. USD, EUR, mm, g, days, weeks, pct, units, man-days",
          "title": "Unit",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Label"
        },
        "source_or_assumption": {
          "description": "Sourced: '<source>, <YYYY-MM-DD>'. Estimate: the assumption. Measured: the check. Fictional: 'demo data'.",
          "title": "Source Or Assumption",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit",
        "label",
        "source_or_assumption"
      ],
      "title": "LabeledValue",
      "type": "object"
    },
    "ProcessType": {
      "enum": [
        "injection_molding",
        "cnc",
        "sheet_metal",
        "die_casting",
        "extrusion",
        "pcba",
        "assembly",
        "other"
      ],
      "title": "ProcessType",
      "type": "string"
    },
    "RiskLevel": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "critical",
        "major",
        "minor"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SpecPart": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "material": {
          "title": "Material",
          "type": "string"
        },
        "finish": {
          "title": "Finish",
          "type": "string"
        },
        "process_hint": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProcessType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tolerance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. '\u00b10.1 mm on mating faces'",
          "title": "Tolerance"
        },
        "dimensions": {
          "anyOf": [
            {
              "$ref": "#/$defs/Dimensions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "wall_thickness": {
          "anyOf": [
            {
              "$ref": "#/$defs/LabeledValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quantity": {
          "default": 1,
          "title": "Quantity",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "material",
        "finish"
      ],
      "title": "SpecPart",
      "type": "object"
    },
    "StructuredSpec": {
      "additionalProperties": false,
      "properties": {
        "overall_dimensions": {
          "$ref": "#/$defs/Dimensions"
        },
        "weight": {
          "$ref": "#/$defs/LabeledValue"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/SpecPart"
          },
          "title": "Parts",
          "type": "array"
        },
        "tolerances": {
          "items": {
            "type": "string"
          },
          "title": "Tolerances",
          "type": "array"
        }
      },
      "required": [
        "overall_dimensions",
        "weight",
        "parts",
        "tolerances"
      ],
      "title": "StructuredSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "fallback": {
      "default": false,
      "title": "Fallback",
      "type": "boolean"
    },
    "cached_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set when any of stages 1-7 served a cached example: shown on the Factory Pack and the Launch Dossier cover",
      "title": "Cached Note"
    },
    "fallback_stages": {
      "description": "Stages 1-7 that served a cached example",
      "items": {
        "type": "integer"
      },
      "title": "Fallback Stages",
      "type": "array"
    },
    "product_name": {
      "title": "Product Name",
      "type": "string"
    },
    "product_summary": {
      "title": "Product Summary",
      "type": "string"
    },
    "product_summary_cn": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Product Summary Cn"
    },
    "target_markets": {
      "items": {
        "type": "string"
      },
      "title": "Target Markets",
      "type": "array"
    },
    "spec": {
      "$ref": "#/$defs/StructuredSpec"
    },
    "cad_files": {
      "items": {
        "$ref": "#/$defs/CadFile"
      },
      "title": "Cad Files",
      "type": "array"
    },
    "bom": {
      "items": {
        "$ref": "#/$defs/BOMItem"
      },
      "title": "Bom",
      "type": "array"
    },
    "dfm_alerts": {
      "items": {
        "$ref": "#/$defs/DFMIssue"
      },
      "title": "Dfm Alerts",
      "type": "array"
    },
    "certifications": {
      "items": {
        "$ref": "#/$defs/Certification"
      },
      "title": "Certifications",
      "type": "array"
    },
    "target_quantities": {
      "items": {
        "type": "integer"
      },
      "title": "Target Quantities",
      "type": "array"
    },
    "cost_estimate": {
      "items": {
        "$ref": "#/$defs/CostTier"
      },
      "title": "Cost Estimate",
      "type": "array"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/FactoryQuestion"
      },
      "title": "Questions",
      "type": "array"
    },
    "assumption_register": {
      "items": {
        "$ref": "#/$defs/Assumption"
      },
      "title": "Assumption Register",
      "type": "array"
    }
  },
  "required": [
    "id",
    "project_id",
    "product_name",
    "product_summary",
    "target_markets",
    "spec",
    "cad_files",
    "bom",
    "dfm_alerts",
    "certifications",
    "target_quantities",
    "cost_estimate",
    "questions",
    "assumption_register"
  ],
  "title": "FactoryPack",
  "type": "object"
}
