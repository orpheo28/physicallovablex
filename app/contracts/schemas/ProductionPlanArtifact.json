{
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Label"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "stage": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stage that introduced the assumption",
          "title": "Stage"
        }
      },
      "required": [
        "id",
        "text",
        "label"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "Label": {
      "description": "The four honesty labels. UI text: Measured / Sourced / Estimate / Fictional \u2014 demo data.",
      "enum": [
        "measured",
        "sourced",
        "estimate",
        "fictional"
      ],
      "title": "Label",
      "type": "string"
    },
    "LabeledValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "description": "e.g. USD, EUR, mm, g, days, weeks, pct, units, man-days",
          "title": "Unit",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Label"
        },
        "source_or_assumption": {
          "description": "Sourced: '<source>, <YYYY-MM-DD>'. Estimate: the assumption. Measured: the check. Fictional: 'demo data'.",
          "title": "Source Or Assumption",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit",
        "label",
        "source_or_assumption"
      ],
      "title": "LabeledValue",
      "type": "object"
    },
    "ProcessStep": {
      "additionalProperties": false,
      "properties": {
        "part_id": {
          "title": "Part Id",
          "type": "string"
        },
        "part_name": {
          "title": "Part Name",
          "type": "string"
        },
        "process": {
          "$ref": "#/$defs/ProcessType"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "region": {
          "description": "e.g. 'Shenzhen, Guangdong'",
          "title": "Region",
          "type": "string"
        },
        "lead_time_days": {
          "$ref": "#/$defs/LabeledValue"
        }
      },
      "required": [
        "part_id",
        "part_name",
        "process",
        "reason",
        "region",
        "lead_time_days"
      ],
      "title": "ProcessStep",
      "type": "object"
    },
    "ProcessType": {
      "enum": [
        "injection_molding",
        "cnc",
        "sheet_metal",
        "die_casting",
        "extrusion",
        "pcba",
        "assembly",
        "other"
      ],
      "title": "ProcessType",
      "type": "string"
    },
    "StageStatus": {
      "enum": [
        "not_started",
        "draft",
        "validated"
      ],
      "title": "StageStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/StageStatus",
      "default": "draft"
    },
    "fallback": {
      "default": false,
      "description": "True when served from a fixture after an error",
      "title": "Fallback",
      "type": "boolean"
    },
    "fallback_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Reason"
    },
    "generated_by": {
      "default": "fixture",
      "description": "'fixture' | 'code' | 'llm:<model slug>'",
      "title": "Generated By",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "assumptions": {
      "items": {
        "$ref": "#/$defs/Assumption"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "stage": {
      "const": 6,
      "default": 6,
      "title": "Stage",
      "type": "integer"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/ProcessStep"
      },
      "title": "Steps",
      "type": "array"
    },
    "assembly_notes": {
      "items": {
        "type": "string"
      },
      "title": "Assembly Notes",
      "type": "array"
    },
    "total_lead_time_days": {
      "$ref": "#/$defs/LabeledValue"
    }
  },
  "required": [
    "project_id",
    "steps",
    "total_lead_time_days"
  ],
  "title": "ProductionPlanArtifact",
  "type": "object"
}
