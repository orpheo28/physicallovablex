    "StageStatus": {
      "enum": [
        "not_started",
        "draft",
        "validated"
      ],
      "title": "StageStatus",
      "type": "string"
    },
    "StandardRef": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "e.g. 'IEC 60335-2-2', 'EN 12221-1', 'IEC 60529'",
          "title": "Code",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "applies_because": {
          "title": "Applies Because",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "citation_label": {
          "$ref": "#/$defs/Label",
          "description": "sourced = the URL was checked to load (date in citation_note); estimate = standard to be confirmed"
        },
        "citation_note": {
          "title": "Citation Note",
          "type": "string"
        }
      },
      "required": [
        "code",
        "title",
        "applies_because",
        "citation_label",
        "citation_note"
      ],
      "title": "StandardRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/StageStatus",
      "default": "draft"
    },
    "fallback": {
      "default": false,
      "description": "True when served from a fixture after an error",
      "title": "Fallback",
      "type": "boolean"
    },
    "fallback_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Reason"
    },
    "generated_by": {
      "default": "fixture",
      "description": "'fixture' | 'code' | 'llm:<model slug>'",
      "title": "Generated By",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "assumptions": {
      "items": {
        "$ref": "#/$defs/Assumption"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "stage": {
      "const": "engineering",
      "default": "engineering",
      "title": "Stage",
      "type": "string"
    },
    "category": {
      "description": "Engineering category key, e.g. wearable, furniture_baby, home_robot, vacuum, irrigation, solar_roof, surfboard, lighting, tracker, generic",
      "title": "Category",
      "type": "string"
    },
    "category_title": {
      "title": "Category Title",
      "type": "string"
    },
    "partner_word": {
      "default": "factories",
      "enum": [
        "factories",
        "installers"
      ],
      "title": "Partner Word",
      "type": "string"
    },
    "site_install": {
