# Copy to .env (never commit .env). Without a key every stage serves fixtures (fallback: true).
OPENROUTER_API_KEY=

# OpenRouter slugs checked on openrouter.ai/api/v1/models, 2026-09-26. Never hard-code them in code.
# main = reasoning (spec, DFM review, negotiation). e.g. anthropic/claude-opus-5.5 | openai/gpt-6-sol | anthropic/claude-sonnet-5
LLM_MAIN_MODEL=
# fast = planners, brand, factory agents. e.g. openai/gpt-6-luna | deepseek/deepseek-v4.1-flash
LLM_FAST_MODEL=
# cn = Chinese Factory Pack. e.g. z-ai/glm-5.3 | qwen/qwen3.8-max-0902 | moonshotai/kimi-k3
LLM_CN_MODEL=
# image = stage-2 AI concept renders (image-output model, ≤ LLM_IMAGE_MAX_RENDERS per run, default 1; empty = no renders). e.g. google/gemini-3.1-flash-image
LLM_IMAGE_MODEL=

# Deployed only: when set, the API requires header X-App-Key = this value on every route except GET /health.
# Leave EMPTY for local dev. The web proxy on Vercel sends it server-side (same value in its API_SHARED_KEY).
API_SHARED_KEY=
# Web app password screen (Vercel env, server-only, phase 2). Not read by the API.
# APP_PASSWORD=

# Optional guards / config
# LLM_MAX_TOKENS=8000
# LLM_MAX_REQUESTS=500
# LLM_TIMEOUT_S=60
# LLM_IMAGE_MAX_RENDERS=1        (stage 2 auto-renders the first N directions; others via POST /projects/{id}/stages/2/render)
# STAGE_TIMEOUT_S=45
# LLM_REASONING_EFFORT=low        (OpenRouter reasoning effort: none|minimal|low|medium|high; 'off' = provider default)
# FACTORY_MCP_DB=factory_mcp/data/network.db   (default: next to DB_PATH as factory_network.db)
# FILES_DIR=api/data/files      (generated CAD)
# DB_PATH=api/data/app.db
# CORS_ORIGINS=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:8000   (web/.env.local)
# RATE_LIMIT_PER_DAY=20         (live runs per client IP per 24 h; 0 = off; counted only when OPENROUTER_API_KEY is set)
# DEMO_READONLY=1               (public zero-cost mode: no live AI runs, cached demos only)
# SEED_DEMO_ON_EMPTY=1          (seed the demo projects at startup if the DB is empty; set in the Dockerfile)

# Pro CAD (C1-C5), all on by default since C5 — set only to turn one off (pass-6 behaviour):
# CAD_DETAIL_LEVEL=pro          (basic = no standard parts / DFM detail: the pre-C1 CAD)
# CAD_ASSEMBLY=1                (0 = no GET /projects/{id}/assembly, no "assembly" engineering group, no fastener cost lines)
# CAD_DRAWINGS=1                (0 = no 2D drawings: route, Studio tab, Factory Pack / Dossier chapter)
# CODEGEN_RAG=0                 (keep 0: retrieval-augmented codegen showed no gain, docs/CAD_BENCH.md)
