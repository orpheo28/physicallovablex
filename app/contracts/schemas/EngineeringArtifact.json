          "type": "string"
        },
        "part": {
          "title": "Part",
          "type": "string"
        },
        "active_current": {
          "$ref": "#/$defs/LabeledValue",
          "description": "mA while active"
        },
        "sleep_current": {
          "$ref": "#/$defs/LabeledValue",
          "description": "\u00b5A while idle"
        },
        "duty_cycle": {
          "$ref": "#/$defs/LabeledValue",
          "description": "pct of time active"
        },
        "average_current": {
          "$ref": "#/$defs/LabeledValue",
          "description": "mA, duty-weighted"
        }
      },
      "required": [
        "block",
        "part",
        "active_current",
        "sleep_current",
        "duty_cycle",
        "average_current"
      ],
      "title": "PowerBudgetLine",
      "type": "object"
    },
    "PowerNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
