            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "domain",
        "value",
        "verdict",
        "formula"
      ],
      "title": "EngineeringCheck",
      "type": "object"
    },
