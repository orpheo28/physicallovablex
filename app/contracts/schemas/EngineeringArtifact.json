        },
        "module_power": {
          "$ref": "#/$defs/LabeledValue"
        },
        "module_count": {
          "$ref": "#/$defs/LabeledValue"
        },
        "peak_power": {
          "$ref": "#/$defs/LabeledValue"
        },
        "specific_yield": {
