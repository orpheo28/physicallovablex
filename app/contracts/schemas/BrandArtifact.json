{
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Label"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "stage": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stage that introduced the assumption",
          "title": "Stage"
        }
      },
      "required": [
        "id",
        "text",
        "label"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "Dimensions": {
      "additionalProperties": false,
      "properties": {
        "length": {
          "$ref": "#/$defs/LabeledValue"
        },
        "width": {
          "$ref": "#/$defs/LabeledValue"
        },
        "height": {
          "$ref": "#/$defs/LabeledValue"
        }
      },
      "required": [
        "length",
        "width",
        "height"
      ],
      "title": "Dimensions",
      "type": "object"
    },
    "Label": {
      "description": "The four honesty labels. UI text: Measured / Sourced / Estimate / Fictional \u2014 demo data.",
      "enum": [
        "measured",
        "sourced",
        "estimate",
        "fictional"
      ],
      "title": "Label",
      "type": "string"
    },
    "LabeledValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "description": "e.g. USD, EUR, mm, g, days, weeks, pct, units, man-days",
          "title": "Unit",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Label"
        },
        "source_or_assumption": {
          "description": "Sourced: '<source>, <YYYY-MM-DD>'. Estimate: the assumption. Measured: the check. Fictional: 'demo data'.",
          "title": "Source Or Assumption",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit",
        "label",
        "source_or_assumption"
      ],
      "title": "LabeledValue",
      "type": "object"
    },
    "LandingCopy": {
      "additionalProperties": false,
      "properties": {
        "headline": {
          "title": "Headline",
          "type": "string"
        },
        "subheadline": {
          "title": "Subheadline",
          "type": "string"
        },
        "bullets": {
          "items": {
            "type": "string"
          },
          "title": "Bullets",
          "type": "array"
        },
        "cta": {
          "title": "Cta",
          "type": "string"
        }
      },
      "required": [
        "headline",
        "subheadline",
        "bullets",
        "cta"
      ],
      "title": "LandingCopy",
      "type": "object"
    },
    "ListingDraft": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "shopify",
            "amazon"
          ],
          "title": "Channel",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "bullets": {
          "items": {
            "type": "string"
          },
          "title": "Bullets",
          "type": "array"
        },
        "price": {
          "$ref": "#/$defs/LabeledValue"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        }
      },
      "required": [
        "channel",
        "title",
        "description",
        "bullets",
        "price"
      ],
      "title": "ListingDraft",
      "type": "object"
    },
    "NameOption": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "name",
        "rationale"
      ],
      "title": "NameOption",
      "type": "object"
    },
    "PackagingSpec": {
      "additionalProperties": false,
      "properties": {
        "box_type": {
          "title": "Box Type",
          "type": "string"
        },
        "dimensions": {
          "$ref": "#/$defs/Dimensions"
        },
        "materials": {
          "items": {
            "type": "string"
          },
          "title": "Materials",
          "type": "array"
        },
        "printing": {
          "title": "Printing",
          "type": "string"
        },
        "contents": {
          "items": {
            "type": "string"
          },
          "title": "Contents",
          "type": "array"
        },
        "unit_cost": {
          "$ref": "#/$defs/LabeledValue"
        }
      },
      "required": [
        "box_type",
        "dimensions",
        "materials",
        "printing",
        "contents",
        "unit_cost"
      ],
      "title": "PackagingSpec",
      "type": "object"
    },
    "StageStatus": {
      "enum": [
        "not_started",
        "draft",
        "validated"
      ],
      "title": "StageStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/StageStatus",
      "default": "draft"
    },
    "fallback": {
      "default": false,
      "description": "True when served from a fixture after an error",
      "title": "Fallback",
      "type": "boolean"
    },
    "fallback_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Reason"
    },
    "generated_by": {
      "default": "fixture",
      "description": "'fixture' | 'code' | 'llm:<model slug>'",
      "title": "Generated By",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "assumptions": {
      "items": {
        "$ref": "#/$defs/Assumption"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "stage": {
      "const": 13,
      "default": 13,
      "title": "Stage",
      "type": "integer"
    },
    "name_options": {
      "items": {
        "$ref": "#/$defs/NameOption"
      },
      "minItems": 1,
      "title": "Name Options",
      "type": "array"
    },
    "chosen_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chosen Name"
    },
    "packaging": {
      "$ref": "#/$defs/PackagingSpec"
    },
    "landing_copy": {
      "$ref": "#/$defs/LandingCopy"
    },
    "shopify_listing": {
      "$ref": "#/$defs/ListingDraft"
    },
    "amazon_listing": {
      "$ref": "#/$defs/ListingDraft"
    }
  },
  "required": [
    "project_id",
    "name_options",
    "packaging",
    "landing_copy",
    "shopify_listing",
    "amazon_listing"
  ],
  "title": "BrandArtifact",
  "type": "object"
}
