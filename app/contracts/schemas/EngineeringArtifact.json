        "units",
        "cost_lines",
        "assembly_steps",
        "timeline_weeks",
        "total_cost"
      ],
      "title": "PrototypePath",
      "type": "object"
    },
    "RequiredTest": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "e.g. 'Drop test 1.5 m', 'IPX7 immersion', 'Salt spray 96 h', 'Tip-over'",
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "drop",
            "ingress",
            "salt_spray",
            "tip_over",
            "thermal",
            "electrical",
            "radio",
            "mechanical",
            "battery",
            "chemical",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "standard": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standard"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "method"
      ],
      "title": "RequiredTest",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "critical",
        "major",
        "minor"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SolarDesign": {
