      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "stage": {
      "title": "Stage",
      "type": "integer"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/StageStatus"
    },
    "fallback": {
      "default": false,
      "title": "Fallback",
      "type": "boolean"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    }
  },
  "required": [
    "stage",
    "name",
    "title",
    "status"
  ],
  "title": "StageSummary",
  "type": "object"
