            "$ref": "#/$defs/NetConnection"
          },
          "title": "Connections",
          "type": "array"
        },
        "power_budget": {
          "items": {
            "$ref": "#/$defs/PowerBudgetLine"
          },
          "title": "Power Budget",
          "type": "array"
        },
        "average_current": {
          "$ref": "#/$defs/LabeledValue"
        },
        "battery_voltage": {
          "anyOf": [
            {
              "$ref": "#/$defs/LabeledValue"
            },
            {
              "type": "null"
            }
          ],
