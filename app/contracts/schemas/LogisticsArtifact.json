{
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Label"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "stage": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stage that introduced the assumption",
          "title": "Stage"
        }
      },
      "required": [
        "id",
        "text",
        "label"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "FreightOption": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "sea_lcl",
            "sea_fcl",
            "air",
            "express"
          ],
          "title": "Mode",
          "type": "string"
        },
        "transit_days": {
          "$ref": "#/$defs/LabeledValue"
        },
        "cost_per_unit": {
          "$ref": "#/$defs/LabeledValue"
        }
      },
      "required": [
        "mode",
        "transit_days",
        "cost_per_unit"
      ],
      "title": "FreightOption",
      "type": "object"
    },
    "HTSLine": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "e.g. '9405.21.xx'",
          "title": "Code",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "general_rate": {
          "$ref": "#/$defs/LabeledValue"
        },
        "section_301_rate": {
          "$ref": "#/$defs/LabeledValue"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "code",
        "description",
        "general_rate",
        "section_301_rate",
        "source_url"
      ],
      "title": "HTSLine",
      "type": "object"
    },
    "Label": {
      "description": "The four honesty labels. UI text: Measured / Sourced / Estimate / Fictional \u2014 demo data.",
      "enum": [
        "measured",
        "sourced",
        "estimate",
        "fictional"
      ],
      "title": "Label",
      "type": "string"
    },
    "LabeledValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "description": "e.g. USD, EUR, mm, g, days, weeks, pct, units, man-days",
          "title": "Unit",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Label"
        },
        "source_or_assumption": {
          "description": "Sourced: '<source>, <YYYY-MM-DD>'. Estimate: the assumption. Measured: the check. Fictional: 'demo data'.",
          "title": "Source Or Assumption",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit",
        "label",
        "source_or_assumption"
      ],
      "title": "LabeledValue",
      "type": "object"
    },
    "LandedCostComponent": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "amount": {
          "$ref": "#/$defs/LabeledValue"
        }
      },
      "required": [
        "name",
        "amount"
      ],
      "title": "LandedCostComponent",
      "type": "object"
    },
    "StageStatus": {
      "enum": [
        "not_started",
        "draft",
        "validated"
      ],
      "title": "StageStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/StageStatus",
      "default": "draft"
    },
    "fallback": {
      "default": false,
      "description": "True when served from a fixture after an error",
      "title": "Fallback",
      "type": "boolean"
    },
    "fallback_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Reason"
    },
    "generated_by": {
      "default": "fixture",
      "description": "'fixture' | 'code' | 'llm:<model slug>'",
      "title": "Generated By",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "assumptions": {
      "items": {
        "$ref": "#/$defs/Assumption"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "stage": {
      "const": 11,
      "default": 11,
      "title": "Stage",
      "type": "integer"
    },
    "incoterm": {
      "default": "FOB",
      "enum": [
        "EXW",
        "FOB",
        "CIF",
        "DDP"
      ],
      "title": "Incoterm",
      "type": "string"
    },
    "destination": {
      "title": "Destination",
      "type": "string"
    },
    "quantity": {
      "title": "Quantity",
      "type": "integer"
    },
    "freight_options": {
      "items": {
        "$ref": "#/$defs/FreightOption"
      },
      "title": "Freight Options",
      "type": "array"
    },
    "chosen_mode": {
      "enum": [
        "sea_lcl",
        "sea_fcl",
        "air",
        "express"
      ],
      "title": "Chosen Mode",
      "type": "string"
    },
    "hts": {
      "$ref": "#/$defs/HTSLine"
    },
    "section_122_applied": {
      "default": false,
      "title": "Section 122 Applied",
      "type": "boolean"
    },
    "landed_cost_breakdown": {
      "description": "Per-unit components (PRD \u00a711)",
      "items": {
        "$ref": "#/$defs/LandedCostComponent"
      },
      "title": "Landed Cost Breakdown",
      "type": "array"
    },
    "landed_cost_per_unit": {
      "$ref": "#/$defs/LabeledValue"
    },
    "reconciles_with_stage5": {
      "title": "Reconciles With Stage5",
      "type": "boolean"
    },
    "reconciliation_note": {
      "title": "Reconciliation Note",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "destination",
    "quantity",
    "freight_options",
    "chosen_mode",
    "hts",
    "landed_cost_breakdown",
    "landed_cost_per_unit",
    "reconciles_with_stage5",
    "reconciliation_note"
  ],
  "title": "LogisticsArtifact",
  "type": "object"
}
