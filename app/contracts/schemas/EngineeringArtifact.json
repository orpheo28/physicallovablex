        "mcu_part",
        "power_tree",
        "connections",
        "power_budget",
        "average_current"
      ],
      "title": "ElectronicsArchitecture",
      "type": "object"
    },
    "EngineeringCheck": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "domain": {
          "enum": [
            "stability",
            "hydrodynamics",
            "power",
            "ingress",
            "airflow",
            "fluid",
            "solar",
            "thermal",
            "mass",
            "geometry",
            "flight",
            "regulatory",
            "assembly"
          ],
          "title": "Domain",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/LabeledValue"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
