{
  "$defs": {
    "AssemblyClearance": {
      "additionalProperties": false,
      "properties": {
        "part_id": {
          "description": "Moving part (or the smaller part of an adjacent pair)",
          "title": "Part Id",
          "type": "string"
        },
        "against": {
          "title": "Against",
          "type": "string"
        },
        "min_clearance": {
          "$ref": "#/$defs/LabeledValue",
          "description": "Minimum distance, mm (Measured with BRepExtrema; over the motion range when moving)"
        },
        "motion": {
          "description": "e.g. 'revolute 0-360\u00b0 (12 steps)', 'linear 0-0.8 mm', 'static'",
          "title": "Motion",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/CheckVerdict"
        },
        "rule": {
          "title": "Rule",
          "type": "string"
        }
      },
      "required": [
        "part_id",
        "against",
        "min_clearance",
        "motion",
        "verdict",
        "rule"
      ],
      "title": "AssemblyClearance",
      "type": "object"
    },
    "AssemblyInterference": {
      "additionalProperties": false,
      "properties": {
        "a": {
          "title": "A",
          "type": "string"
        },
        "b": {
          "title": "B",
          "type": "string"
        },
        "volume": {
          "$ref": "#/$defs/LabeledValue",
          "description": "Boolean intersection volume, mm\u00b3 (Measured; tolerance 0.01 mm\u00b3)"
        },
        "kind": {
          "description": "interference = parts that move relative to each other (different rigid bodies, not joint partners) or the two shells of a parting line overlap \u2192 fail; joint_seat = overlap between the two parts of one joint (seat / insertion depth of concept geometry); static_overlap = parts of one rigid body interpenetrate (concept geometry, pocket at detail design)",
          "enum": [
            "interference",
            "joint_seat",
            "static_overlap"
          ],
          "title": "Kind",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "a",
        "b",
        "volume",
        "kind"
      ],
      "title": "AssemblyInterference",
      "type": "object"
    },
    "AssemblyJoint": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "parent": {
          "description": "part_id of the parent (the part that carries the joint)",
          "title": "Parent",
          "type": "string"
        },
        "child": {
          "description": "part_id placed by the joint",
          "title": "Child",
          "type": "string"
        },
        "kind": {
          "description": "build123d RigidJoint / RevoluteJoint / LinearJoint",
          "enum": [
            "rigid",
            "revolute",
            "linear"
          ],
          "title": "Kind",
          "type": "string"
        },
        "method": {
          "enum": [
            "screwed",
            "snap_fit",
            "inlay",
            "press_fit",
            "bonded",
            "clip",
            "hinge",
            "bearing",
            "slide",
            "latch"
          ],
          "title": "Method",
          "type": "string"
        },
        "dof": {
          "description": "Degrees of freedom of the child relative to the parent (0 rigid, 1 revolute / linear)",
          "title": "Dof",
          "type": "integer"
        },
        "origin_mm": {
          "description": "Joint origin, mm, GLB axes (+Y up)",
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Origin Mm",
          "type": "array"
        },
        "axis": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unit joint axis, GLB axes",
          "title": "Axis"
        },
        "range": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Motion range: deg (revolute) or mm (linear)",
          "title": "Range"
        },
        "fasteners": {
          "items": {
            "$ref": "#/$defs/FastenerUse"
          },
          "title": "Fasteners",
          "type": "array"
        },
        "rule": {
          "description": "Why this mate: the family / role rule that inferred it",
          "title": "Rule",
          "type": "string"
        }
      },
      "required": [
        "id",
        "parent",
        "child",
        "kind",
        "method",
        "dof",
        "origin_mm",
        "rule"
      ],
      "title": "AssemblyJoint",
      "type": "object"
    },
    "AssemblyNode": {
      "additionalProperties": false,
      "properties": {
        "part_id": {
          "description": "= PartMeta.part_id of the version GLB",
          "title": "Part Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Parent part_id (None = assembly root)",
          "title": "Parent"
        },
        "joint_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Joint Id"
        },
        "rigid_body": {
          "description": "Parts with the same number move together (connected by rigid joints)",
          "title": "Rigid Body",
          "type": "integer"
        },
        "volume": {
          "$ref": "#/$defs/LabeledValue",
          "description": "Measured solid volume, mm\u00b3"
        },
        "explode_vector": {
          "description": "Unit vector, GLB axes; derived from the joint",
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Explode Vector",
          "type": "array"
        },
        "explode_distance_mm": {
          "description": "Cumulative along the tree (a child moves with its parent)",
          "title": "Explode Distance Mm",
          "type": "number"
        }
      },
      "required": [
        "part_id",
        "name",
        "role",
        "rigid_body",
        "volume",
        "explode_vector",
        "explode_distance_mm"
      ],
      "title": "AssemblyNode",
      "type": "object"
    },
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Label"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "stage": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stage that introduced the assumption",
          "title": "Stage"
        }
      },
      "required": [
        "id",
        "text",
        "label"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "BOMCategory": {
      "enum": [
        "electronic",
        "mechanical",
        "packaging"
      ],
      "title": "BOMCategory",
      "type": "string"
    },
    "BOMItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "part": {
          "title": "Part",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/BOMCategory"
        },
        "qty": {
          "description": "Quantity per finished unit",
          "title": "Qty",
          "type": "number"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "manufacturer_pn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manufacturer Pn"
        },
        "lcsc_pn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. 'C725790' when matched to the LCSC snapshot",
          "title": "Lcsc Pn"
        },
        "unit_cost_est": {
          "anyOf": [
            {
              "$ref": "#/$defs/LabeledValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "risk": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentRisk"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "alternative": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alternative"
        }
      },
      "required": [
        "id",
        "part",
        "category",
        "qty"
      ],
      "title": "BOMItem",
      "type": "object"
    },
    "BuildStrategy": {
      "additionalProperties": false,
      "description": "W21: how this product realistically gets built \u2014 design everything, assemble bought-in modules, or customise an\nODM reference platform. Figures are Estimates with their assumptions.",
      "properties": {
        "strategy": {
          "enum": [
            "full_design",
            "module_assembly",
            "odm_customization"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "title": {
          "description": "e.g. 'Full design', 'Module assembly', 'ODM customisation'",
          "title": "Title",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "customisable": {
          "description": "What the founder designs / chooses",
          "items": {
            "type": "string"
          },
          "title": "Customisable",
          "type": "array"
        },
        "not_customisable": {
          "description": "What comes from the modules / the ODM platform",
          "items": {
            "type": "string"
          },
          "title": "Not Customisable",
          "type": "array"
        },
        "moq": {
          "$ref": "#/$defs/LabeledValue",
          "description": "Typical minimum order quantity (units), Estimate"
        },
        "entry_cost": {
          "$ref": "#/$defs/LabeledValue",
          "description": "Typical entry cost (NRE, tooling, certification) before the first order, Estimate"
        },
        "lead_time": {
          "$ref": "#/$defs/LabeledValue",
          "description": "Typical time from frozen design to first production units (weeks), Estimate"
        },
        "path": {
          "description": "Realistic steps (for ODM: find a close reference platform\u2026)",
          "items": {
            "type": "string"
          },
          "title": "Path",
          "type": "array"
        },
        "certifications_note": {
          "default": "",
          "title": "Certifications Note",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        }
      },
      "required": [
        "strategy",
        "title",
        "explanation",
        "customisable",
        "moq",
        "entry_cost",
        "lead_time"
      ],
      "title": "BuildStrategy",
      "type": "object"
    },
    "CheckVerdict": {
      "enum": [
        "pass",
        "warn",
        "fail",
        "info"
      ],
      "title": "CheckVerdict",
      "type": "string"
    },
    "ComponentRisk": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "$ref": "#/$defs/RiskLevel"
        },
        "reasons": {
          "description": "e.g. EOL, single source, long lead time, low stock",
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "level"
      ],
      "title": "ComponentRisk",
      "type": "object"
    },
    "DesignRisk": {
      "additionalProperties": false,
