        },
        "risk": {
          "title": "Risk",
          "type": "string"
        },
        "mitigation": {
          "title": "Mitigation",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "major"
        }
      },
      "required": [
        "id",
        "risk",
        "mitigation"
      ],
      "title": "DesignRisk",
      "type": "object"
    },
    "DevKitLine": {
